# 复制为 .env 后填写。.env 不会进 Git。
# mock = 规则模板生成 SQL，无需联网，用于跑通链路与自测
# real = 调用大模型，需要 API Key
LLM_MODE=mock
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TEMPERATURE=0

# 通义千问：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 硅基流动：LLM_BASE_URL=https://api.siliconflow.cn/v1

MAX_STEPS=6
QUERY_TIMEOUT=5
ROW_LIMIT=1000

# ── v0.12 新增 ────────────────────────────────────────────────
# 模型调用通道：langchain（默认，走 langchain_openai.ChatOpenAI）
#               urllib（备用，标准库直连 OpenAI 兼容接口）
# 两条通道打同一个接口，出问题时可直接切换，不影响评估口径。
LLM_BACKEND=langchain
# 本机证书链吊销检查失败时置 0（只影响对模型厂商的 HTTPS 请求）
LLM_VERIFY_SSL=1

# 数据后端：sqlite（评估固定用）/ mysql（演示与部署）
DB_BACKEND=sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bishe
# 也可以直接给完整连接串，优先级高于上面五个分项：
# MYSQL_URL=mysql+pymysql://root:密码@127.0.0.1:3306/bishe?charset=utf8mb4
#
# 免密码演示（推荐）：双击 start_mysql_demo.bat 会在 3307 起一个独立实例
# （数据目录 E:/tmp/mysql3307/data，不碰本机 3306），它自己注入下面这行：
# MYSQL_URL=mysql+pymysql://root@127.0.0.1:3307/bishe?charset=utf8mb4
# 要手动连这个实例，把 MYSQL_PORT 改成 3307 并留空 MYSQL_PASSWORD 即可。

# 向量检索（pgvector）：先跑 docker compose up -d 与 scripts/setup_pgvector.py
PGVECTOR_URL=postgresql://postgres:postgres@127.0.0.1:5433/bishe_vec
# 叠加向量打分（默认 0 以保持 v0.6~v0.11 的评估数字可比）
ENABLE_VECTOR_RETRIEVAL=0
